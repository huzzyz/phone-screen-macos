#!/bin/bash
case "$1" in
    start-server) exit 0 ;;
    devices)
        printf 'List of devices attached\n'
        [ -f "$PHONE_SCREEN_CACHE_DIR/fixture-connected" ] && printf '192.0.2.20:43210\tdevice product:test model:Test_Phone\n'
        ;;
    mdns) exit 0 ;;
    connect) [ "$2" = "192.0.2.20:43210" ] && touch "$PHONE_SCREEN_CACHE_DIR/fixture-connected" ;;
    -s)
        [ "$2" = "192.0.2.20:43210" ] || exit 1
        [ "$3" = "get-state" ] && printf 'device\n'
        [ "$3" = "shell" ] && [ "$5" = "ro.serialno" ] && printf 'PHONE-ONE\n'
        ;;
    *) exit 1 ;;
esac
